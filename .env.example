# Copie para .env e preencha — ou rode "npm run setup" para gerar tudo automaticamente.
# NUNCA commite o .env. Valores "troque-me" impedem a API de subir.

# Servidor
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Autenticação — mínimo de 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-me

# Rate limit (CLAUDE.md, seção 4.4) — janela de 1 minuto
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_IP_MAX=600
RATE_LIMIT_USUARIO_MAX=120
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=30

# Logs de erro
LOG_FILE=logs/log_api.log
LOG_LEVEL=info

# Senhas dos usuários mock (uma por usuário; mínimo de 8 caracteres)
MOCK_SENHA_FLORIANOPOLIS_ADMIN=troque-me
MOCK_SENHA_FLORIANOPOLIS_SERVIDOR=troque-me
MOCK_SENHA_JOINVILLE_ADMIN=troque-me
MOCK_SENHA_JOINVILLE_INATIVO=troque-me
MOCK_SENHA_GOVSC_ADMIN=troque-me
