    "/processos": {
      "get": {
        "summary": "Lista os processos do órgão (tenant) autenticado",
        "tags": [
          "Processos"
        ],
        "parameters": [
          {
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Página (começa em 1)"
          },
          {
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Itens por página (1 a 100)"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "em_andamento",
                "concluido"
              ]
            },
            "in": "query",
            "name": "status",
            "required": false,
            "description": "Filtra pelo status do processo"
          }
        ],
        "security": [
          {
            "tenantId": [],
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Identificador único (UUID)"
                          },
                          "numero": {
                            "type": "string",
                            "description": "Número do processo"
                          },
                          "titulo": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "em_andamento",
                              "concluido"
                            ]
                          },
                          "criadoEm": {
                            "type": "string",
                            "description": "Data de criação em ISO 8601 (UTC)"
                          }
                        },
                        "required": [
                          "id",
                          "numero",
                          "titulo",
                          "status",
                          "criadoEm"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "total": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "Total de itens considerando os filtros"
                    },
                    "page": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "Página retornada"
                    }
                  },
                  "required": [
                    "data",
                    "total",
                    "page"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
